# StreamDock (HOTSPOTEKUSB) udev rules
#
# Do NOT copy this file manually — use scripts/install.sh instead.
# That script also installs the streamdock-udev-helper and the systemd user service.
#
# What this file does:
#   1. Grants the "plugdev" group rw access to the USB device so the application
#      can open it via libhidapi-libusb without running as root.
#   2. Grants access to the hidraw node (needed by libhidapi-hidraw / pyusb).
#   3. Calls streamdock-udev-helper on plug/unplug to start/stop the user service.
#      The RUN+= triggers use SUBSYSTEM=="hidraw" so the service only starts
#      after the HID layer has fully initialised the device node, avoiding a
#      race where the application tries to open the device before it is ready.

# Grant plugdev group access to the USB device node (libhidapi-libusb backend)
SUBSYSTEM=="usb", ATTR{idVendor}=="6603", ATTR{idProduct}=="1006", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Grant plugdev group access to the hidraw node (libhidapi-hidraw / pyusb backend)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1006", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Auto-start the application when the device HID layer is ready
ACTION=="add",    SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1006", \
    RUN+="/usr/local/bin/streamdock-udev-helper start"

# Auto-stop the application when the device is disconnected
ACTION=="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1006", \
    RUN+="/usr/local/bin/streamdock-udev-helper stop"
